# --- Environment ---
NODE_ENV=production         # production | development | test

# --- Database ---
# SQLite file, resolved relative to the project root (not the working directory).
# DB_NAME is used in production; DB_NAME_TEST in development. NODE_ENV=test always
# uses an in-memory database. Migrations run automatically at startup.
DB_NAME=database.sqlite3
DB_NAME_TEST=database.dev.sqlite3

# --- Server ---
PORT=8080
LOG_LEVEL=info              # trace | debug | info | warn | error | fatal | silent
